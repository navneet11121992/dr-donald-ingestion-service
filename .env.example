# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=your-bucket-name

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small = 1536 dims, text-embedding-3-large = 3072 dims

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=library_documents

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Server
PORT=4000
# Shared secret WordPress must send so this endpoint isn't publicly callable by anyone
INGEST_WEBHOOK_SECRET=change_me_to_a_long_random_string
